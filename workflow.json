            {
              "id": "cond-critical-damage",
              "leftValue": "={{ $json.total_damage_index }}",
              "operator": {
                "operation": "gte",
                "type": "number"
              },
              "rightValue": 1
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
