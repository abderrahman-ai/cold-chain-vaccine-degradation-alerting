      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "2f47b234-ed8a-4c4a-8a0b-c9453dceabb9"
    },
    {
      "parameters": {
        "jsCode": "// Arrhenius relative rate calculation:\nconst R = 8.314;               // J/(mol*K)\nconst Ea = 85000;              // J/mol (activation energy)\nconst T_ref = 253.15;          // -20°C in Kelvin (storage baseline)\n\nconst items = $input.all();\nreturn items.map(item => {\n  const data = item.json.body ? item.json.body : item.json;\n  const tempK = (data.temperature_c !== undefined ? Number(data.temperature_c) : 0) + 273.15;\n  const intervalMin = data.interval_minutes !== undefined ? Number(data.interval_minutes) : 0;\n  const cumulativeDamage = data.cumulative_damage_index !== undefined ? Number(data.cumulative_damage_index) : 0;\n\n  // Kinetic acceleration factor relative to -20°C\n  const accelFactor = Math.exp((-Ea / R) * ((1 / tempK) - (1 / T_ref)));\n\n  // Incremental thermal budget consumed in hours\n  const deltaDamage = accelFactor * (intervalMin / 60);\n  const updatedDamage = cumulativeDamage + deltaDamage;\n  const isCritical = updatedDamage >= 1.0;\n\n  return {\n    json: {\n      batch_id: data.batch_id || 'UNKNOWN-BATCH',\n      current_temp_c: data.temperature_c,\n      interval_min: intervalMin,\n      incremental_damage: Number(deltaDamage.toFixed(4)),\n      total_damage_index: Number(updatedDamage.toFixed(4)),\n      threshold_limit: 1.0,\n      status: isCritical ? 'CRITICAL_DEGRADATION' : 'NOMINAL',\n      flagged_for_quarantine: isCritical,\n      timestamp: new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "node_arrhenius",
      "name": "Arrhenius Kinetic Engine",
      "position": [
        512,
        304
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
